# Copy to your environment / process manager. Do NOT commit real secrets.
# All values fall back to legacy defaults in code if unset, but production
# MUST set at least JWT_SECRET, MONGO_CONN and the service tokens below.

# Auth — used to sign/verify JWTs. Rotate this; 'didi' is a dev-only default.
JWT_SECRET=

# HTTP server
SERVER_PORT=80
SERVER_HOST=localhost
DOMAIN=bridgeplus.cn

# MongoDB connection string
MONGO_CONN=mongodb://127.0.0.1:27017/iEtales

# BBS / community forum integration
BBS_SERVICE=http://community.hcd.com:4567/
BBS_TOKEN=

# SMS / messaging gateway
MESSAGE_APPID=10129
MESSAGE_APPKEY=
